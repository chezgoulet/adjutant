<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.

  The app writes one preferences file (Flutter's `FlutterSharedPreferences`),
  which holds the read cache, the queued-write list and the server address. The
  session bearer token is no longer there — it lives in
  `flutter_secure_storage` under a Keystore-wrapped key (#169) — but the rest is
  still one member's troop records, and it must not leave the device in an
  automatic backup.

  `allowBackup="false"` in AndroidManifest.xml is the primary switch. These
  rules are the belt-and-braces the issue asks for: if that attribute is ever
  relaxed, the preferences file is still excluded. `domain="sharedpref" path="."`
  excludes the whole preferences domain rather than guessing the file name,
  because a Flutter upgrade may rename it and a rule that missed would silently
  start backing data up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
